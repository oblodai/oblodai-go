              "amount_remaining": "25",
              "commission": "0.5",
              "fee_percent": "2",
              "exchange_rate": "1",
              "method_adjustment": "0",
              "method_adjustment_bps": 0,
              "network_surcharge": "0",
              "network_surcharge_bps": 0,
              "confirmations": 0,
              "required_confirmations": 20,
              "is_final": false,
              "is_multi": false,
              "is_test": true,
              "additional_data": "",
              "document_url": "",
              "payer_address": "",
              "payer_address_is_refundable": false,
              "payer_email": "",
              "tx_list": [],
              "txid": "",
              "url": "https://pay.example/x",
              "url_return": "",
              "url_success": "",
              "created_at": "2026-09-24T10:00:00Z",
              "updated_at": "2026-09-24T10:00:00Z",
              "expired_at": "2026-09-24T11:00:00Z",
              "rate_expires_at": "2026-09-24T10:15:00Z",
              "paid_at": null
            }
          }
        }
      ],
      "expect": {
        "requests": 2,
        "same_idempotency_key": true,
        "idempotency_key": "present",
        "delays_ms": [
          1000
        ],
        "result_field": {
          "uuid": "x"
        }
      }
    },
