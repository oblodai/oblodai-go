# Учётные данные Oblodai. ТОЛЬКО для серверной среды — секрет никогда не должен попадать
# в браузер или мобильное приложение. Скопируйте в `.env` и подставьте свои значения.

# Ключи выдаются в кабинете Oblodai (https://oblodai.com), в разделе API-ключей. Секрет
# показывается ОДИН РАЗ — при создании ключа; потерянный не восстанавливается, выпускается новый.
# Для разработки берите тестовый ключ (public_id вида test_…, секрет вида oblodai_test_…) —
# он работает против песочницы. Боевой секрет выглядит как oblodai_live_…; код не меняется.

# Обязательные:
OBLODAI_PUBLIC_ID=test_public_id_here
OBLODAI_SECRET=oblodai_test_secret_here

# Необязательно — переопределяет базовый URL API (по умолчанию https://api.oblodai.com).
# Схема обязана быть https:// — исключение только для локального стенда на петле
# (например http://localhost:8095):
# OBLODAI_BASE_URL=https://api.oblodai.com
