# Oblodai credentials. SERVER-SIDE ONLY — the secret must never reach a browser or a mobile app.
# Copy to .env and fill in your own values.

# A merchant has ONE API key, issued in the Oblodai dashboard (https://oblodai.com) under API keys,
# and it signs every gated route — payments and payouts alike. The secret is shown ONCE, when the
# key is created; a lost one is not recoverable, you issue a new key. For development take a sandbox
# key (public_id like test_oblodai_…, secret like oblodai_test_…): it drives a chainless copy of the
# gateway. A live pair is oblodai_… / oblodai_live_…; the code does not change.
OBLODAI_PUBLIC_ID=test_oblodai_public_id_here
OBLODAI_SECRET=oblodai_test_secret_here

# Optional: overrides the API origin (default https://api.oblodai.com). The scheme must be https,
# except on loopback (for example http://127.0.0.1:8095).
# OBLODAI_BASE_URL=https://api.oblodai.com

# Optional: admin token of a self-hosted gateway; only merchant provisioning sends it.
# OBLODAI_ADMIN_TOKEN=

# Optional: debug | info | warn | error — installs a text logger on stderr.
# OBLODAI_LOG=debug

# Optional: 1 permits a plain http:// base URL on a host that is not loopback.
# OBLODAI_ALLOW_INSECURE=

# Webhook receiver (see examples/webhook-receiver): the endpoint secret from Webhooks.Register or
# Webhooks.RotateSecret, plus the outgoing one during a rotation (keep it for at least 26 hours).
# OBLODAI_WEBHOOK_SECRET=
# OBLODAI_WEBHOOK_SECRET_PREVIOUS=

# Live tests: the core to run them against (they skip without it).
# OBLODAI_LIVE_URL=http://127.0.0.1:8095
# OBLODAI_LIVE_HOOK_URL=http://127.0.0.1:8096/hook
